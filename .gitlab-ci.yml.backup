# Gecko CI/CD Pipeline
# Build and release for Android, iOS, and Linux Desktop
#
# OPTIMIZED VERSION: Uses custom Docker image from Docker Hub with pre-installed dependencies
# To build and push: ./scripts/build-and-push-ci-image.sh <version>
# Docker Hub: https://hub.docker.com/r/poka/gecko-ci

stages:
  - format
  - build
  - deploy
  - release

variables:
  FLUTTER_VERSION: "3.32.8"

# Base job for Flutter environment (optimized with pre-installed dependencies)
.flutter_env:
  image: poka/gecko-ci:latest  # Custom image with all dependencies pre-installed
  before_script:
    - echo "Using optimized Flutter environment..."
    - flutter --version
    - ./scripts/setup-ci-dependencies.sh
  tags:
    - docker

# Android-specific environment (optimized with pre-installed Java 17)
.android_env:
  image: poka/gecko-ci:latest  # Custom image with Java 17 and Android tools pre-installed
  variables:
    JAVA_HOME: /usr/lib/jvm/java-17-openjdk-amd64
  before_script:
    - echo "Using optimized Android build environment..."
    - export PATH=$JAVA_HOME/bin:$PATH
    - java -version
    - flutter --version
    - ./scripts/setup-ci-dependencies.sh
    - ./scripts/setup-android-signing.sh
  tags:
    - docker

# Format check job
format:
  extends: .flutter_env
  stage: format
  rules:
    - when: always
  script:
    - dart format --set-exit-if-changed lib

# Build Android APKs (split by architecture)
build:android:apk:
  extends: .android_env
  stage: build
  rules:
    - if: $CI_COMMIT_TAG
    - when: manual
  script:
    # Extract version from pubspec.yaml
    - export VERSION=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $1}')
    - export BUILD=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $2}')
    - echo "Building Gecko Android APKs v${VERSION}+${BUILD}"
    
    # Clean and build
    - flutter clean
    - flutter pub get
    - flutter build apk --release --split-per-abi --build-name $VERSION --build-number $BUILD
    
    # Rename APKs with version
    - mkdir -p artifacts/android
    - mv build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk artifacts/android/gecko-${VERSION}+${BUILD}-v7a.apk
    - mv build/app/outputs/flutter-apk/app-arm64-v8a-release.apk artifacts/android/gecko-${VERSION}+${BUILD}-v8a.apk
    - mv build/app/outputs/flutter-apk/app-x86_64-release.apk artifacts/android/gecko-${VERSION}+${BUILD}-x86_64.apk
    
    # Store version info for later jobs
    - echo "${VERSION}+${BUILD}" > artifacts/version.txt
  artifacts:
    paths:
      - artifacts/
    expire_in: 1 month

# Build Android App Bundle for Play Store
build:android:bundle:
  extends: .android_env
  stage: build
  rules:
    - if: $CI_COMMIT_TAG
    - when: manual
  script:
    - export VERSION=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $1}')
    - export BUILD=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $2}')
    - echo "Building Gecko Android Bundle v${VERSION}+${BUILD}"
    
    - flutter clean
    - flutter pub get
    - flutter build appbundle --release --build-name $VERSION --build-number $BUILD
    
    - mkdir -p artifacts/android
    - mv build/app/outputs/bundle/release/app-release.aab artifacts/android/gecko-${VERSION}+${BUILD}.aab
  artifacts:
    paths:
      - artifacts/android/*.aab
    expire_in: 1 month

# Build iOS (requires macOS runner)
build:ios:
  stage: build
  tags:
    - macos
    - shared
  rules:
    - if: $CI_COMMIT_TAG
    - when: manual
  before_script:
    # Install Flutter on macOS
    - |
      if ! command -v flutter &> /dev/null; then
        echo "Installing Flutter..."
        git clone https://github.com/flutter/flutter.git -b stable ~/flutter
        export PATH="$PATH:~/flutter/bin"
      fi
    - flutter --version
    - flutter pub get
  script:
    - export VERSION=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $1}')
    - export BUILD=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $2}')
    - echo "Building Gecko iOS IPA v${VERSION}+${BUILD}"
    
    # Update Info.plist temporarily
    - sed -i '' "s|\$(FLUTTER_BUILD_NAME)|${VERSION}|g" ios/Runner/Info.plist
    - sed -i '' "s|\$(fFLUTTER_BUILD_NUMBER)|${BUILD}|g" ios/Runner/Info.plist
    
    - flutter clean
    - flutter pub get
    - flutter build ipa --release --build-name=$VERSION --build-number=$BUILD --export-options-plist=ios/ExportOptions.plist
    
    # Restore Info.plist
    - git checkout ios/Runner/Info.plist
    
    - mkdir -p artifacts/ios
    - mv build/ios/ipa/gecko.ipa artifacts/ios/gecko-${VERSION}+${BUILD}.ipa
  artifacts:
    paths:
      - artifacts/ios/
    expire_in: 1 month

# Build Linux Desktop (optimized with pre-installed build tools)
build:linux:
  extends: .flutter_env
  stage: build
  rules:
    - if: $CI_COMMIT_TAG
    - when: manual
  before_script:
    - echo "Using optimized Linux build environment..."
    - flutter --version
    - flutter pub get
  script:
    - export VERSION=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $1}')
    - export BUILD=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $2}')
    - echo "Building Gecko Linux Desktop v${VERSION}+${BUILD}"
    
    - flutter clean
    - flutter pub get
    - flutter build linux --release --build-name=$VERSION --build-number=$BUILD
    
    # Create AppImage or tar.gz
    - mkdir -p artifacts/linux
    - cd build/linux/x64/release/bundle
    - tar -czf ../../../../../artifacts/linux/gecko-${VERSION}+${BUILD}-linux-x64.tar.gz .
    - cd -
  artifacts:
    paths:
      - artifacts/linux/
    expire_in: 1 month

# Deploy to Google Play Store (optimized with pre-installed fastlane)
deploy:android:playstore:
  extends: .android_env
  stage: deploy
  dependencies:
    - build:android:bundle
  rules:
    - if: $CI_COMMIT_TAG
      when: manual
    - when: never
  before_script:
    - echo "Using optimized deployment environment..."
    - fastlane --version
    - flutter pub get
  script:
    - export VERSION=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $1}')
    - export BUILD=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $2}')
    
    # Create Google Play API key file from base64 encoded CI variable
    - echo "$GOOGLE_PLAY_JSON_KEY_BASE64" | base64 -d > google-play-key.json
    
    # Deploy using fastlane
    - |
      fastlane supply \
        --aab "artifacts/android/gecko-${VERSION}+${BUILD}.aab" \
        --track "${GOOGLE_PLAY_TRACK:-internal}" \
        --package_name "$ANDROID_PACKAGE_NAME" \
        --json_key "google-play-key.json" \
        --release_status "${GOOGLE_PLAY_RELEASE_STATUS:-completed}" \
        --skip_upload_metadata \
        --skip_upload_images \
        --skip_upload_screenshots \
        --skip_upload_changelogs
  after_script:
    - rm -f google-play-key.json

# Deploy to App Store Connect
deploy:ios:appstore:
  stage: deploy
  tags:
    - macos
    - shared
  dependencies:
    - build:ios
  rules:
    - if: $CI_COMMIT_TAG
      when: manual
    - when: never
  before_script:
    # Install fastlane on macOS
    - gem install fastlane -NV
  script:
    - export VERSION=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $1}')
    - export BUILD=$(grep "version:" pubspec.yaml | awk '{print $2}' | awk -F'+' '{print $2}')
    
    # Create App Store Connect API key file from base64 encoded CI variable
    - echo "$APP_STORE_CONNECT_API_KEY_BASE64" | base64 -d > app-store-key.p8
    
    # Create API key JSON for fastlane
    - |
      cat > api_key.json << EOF
      {
        "key_id": "$APP_STORE_CONNECT_API_KEY_ID",
        "issuer_id": "$APP_STORE_CONNECT_API_ISSUER_ID",
        "key": "$(cat app-store-key.p8)"
      }
      EOF
    
    # Deploy using fastlane
    - |
      fastlane deliver \
        --api_key_path "api_key.json" \
        --app_identifier "$IOS_APP_IDENTIFIER" \
        --ipa "artifacts/ios/gecko-${VERSION}+${BUILD}.ipa" \
        --skip_screenshots \
        --skip_metadata \
        --precheck_include_in_app_purchases false \
        --force \
        --submit_for_review \
        --automatic_release false
  after_script:
    - rm -f app-store-key.p8 api_key.json

# Publish to Duniter Forum (optimized with pre-installed Python dependencies)
publish:forum:
  image: poka/gecko-ci:latest  # Use optimized image with Python and pydiscourse pre-installed
  stage: release
  dependencies:
    - build:android:apk
  rules:
    - if: $CI_COMMIT_TAG
      when: manual
    - when: never
  before_script:
    - echo "Using optimized Python environment..."
    - python3 --version
    - pip3 show pydiscourse
  script:
    - export VERSION=$(cat artifacts/version.txt)
    
    # Generate changelog from git commits (like in pushGecko script)
    - git fetch --tags
    - LAST_VERSION=$(git tag --sort=-v:refname | sed -n '2p')
    - |
      if [ -n "$LAST_VERSION" ]; then
        TAG_MESSAGE=$(git log --pretty="format:- %s ([%h]($CI_PROJECT_URL/-/commit/%h))" HEAD...$LAST_VERSION --no-merges --reverse)
      else
        TAG_MESSAGE="Initial release"
      fi
    
    # Create forum message based on pushGecko template
    - |
      cat > /tmp/gecko_release.txt << EOF
      New version **$VERSION** of Ğecko mobile

      $TAG_MESSAGE

      This is a **BETA** build, connect to **ĞTest** network.
      ĞTest is a Duniter v2s test currency which is mirror of Ğ1 data blockchain.
      Every action you make on this network **doesn't affect Ğ1 currency**.

      For more questions about Duniter v2s, please read this category or create a new topic here: https://forum.duniter.org/c/dev/duniter-v2s/57

      For questions about gecko app, please ask on this topic: https://forum.duniter.org/t/gecko-talks-user-support/9372/last

      Download for **Android**:

      armeabi-v7a (old phones): **$CI_PROJECT_URL/-/releases/$CI_COMMIT_TAG/downloads/gecko-$VERSION-v7a.apk**

      arm64-v8a (new phones): **$CI_PROJECT_URL/-/releases/$CI_COMMIT_TAG/downloads/gecko-$VERSION-v8a.apk**

      x86_64 (x86_64 CPU phones): **$CI_PROJECT_URL/-/releases/$CI_COMMIT_TAG/downloads/gecko-$VERSION-x86_64.apk**

      **iOS**: Available on the App Store

      **Linux Desktop**: **$CI_PROJECT_URL/-/releases/$CI_COMMIT_TAG/downloads/gecko-$VERSION-linux-x64.tar.gz**
      EOF
    
    # Create Python script based on pushMessage.py
    - |
      cat > publish_forum.py << 'EOF'
      from pydiscourse import DiscourseClient
      from pydiscourse.exceptions import DiscourseClientError
      import os
      import logging

      # Configuration from environment variables
      api_id = os.getenv('DUNITER_FORUM_USERNAME', 'GeckoBuilds')
      forum_api_key = os.getenv('DUNITER_FORUM_API_KEY')
      topic_id = int(os.getenv('DUNITER_FORUM_TOPIC_ID', '9367'))
      forum_url = os.getenv('DUNITER_FORUM_URL', 'https://forum.duniter.org/')

      # Read message from file
      with open('/tmp/gecko_release.txt') as f:
          message = f.read()

      def publish_message_on_forum():
          discourse_client = DiscourseClient(
              forum_url, api_username=api_id, api_key=forum_api_key
          )
          try:
              response = discourse_client.create_post(message, topic_id=topic_id)
              print(f"✅ Published on {forum_url}t/{response['topic_slug']}/{str(topic_id)}/last")
              return True
          except DiscourseClientError as error:
              logging.error(f"❌ Issue publishing on forum: {error}")
              return False

      # Print message for debugging
      print("📝 Forum message content:")
      print("=" * 50)
      print(message)
      print("=" * 50)

      # Publish to forum
      if publish_message_on_forum():
          print("🚀 Forum announcement published successfully!")
      else:
          print("❌ Failed to publish forum announcement")
          exit(1)
      EOF
    
    # Execute the forum publishing script
    - python publish_forum.py

# Create GitLab Release
release:gitlab:
  stage: release
  image: registry.gitlab.com/gitlab-org/release-cli:latest
  dependencies:
    - build:android:apk
    - build:android:bundle
    - build:ios
    - build:linux
  rules:
    - if: $CI_COMMIT_TAG
    - when: never
  script:
    - apk update && apk add git
    - export VERSION=$(cat artifacts/version.txt)
    
    # Generate changelog
    - git fetch --tags
    - LAST_VERSION=$(git tag --sort=-v:refname | sed -n '2p')
    - |
      if [ -n "$LAST_VERSION" ]; then
        git log --pretty="format:- %s ([%h]($CI_PROJECT_URL/-/commit/%h))" HEAD...$LAST_VERSION --reverse > release_description.txt
      else
        echo "Initial release" > release_description.txt
      fi
  release:
    name: "Gecko v$CI_COMMIT_TAG"
    description: |
      ## What's New
      
      $(cat release_description.txt)
      
      ## Downloads
      
      ### Android
      - **Google Play Store**: Available through the Play Store app
      - **Direct APK downloads**: See assets below
      
      ### iOS
      - **App Store**: Available through the App Store app
      
      ### Linux Desktop
      - **tar.gz archive**: See assets below
    tag_name: "$CI_COMMIT_TAG"
    assets:
      links:
        # Android APKs
        - name: "Gecko v$CI_COMMIT_TAG APK (ARMv7)"
          url: "$CI_PROJECT_URL/-/jobs/artifacts/$CI_COMMIT_TAG/raw/artifacts/android/gecko-${VERSION}-v7a.apk?job=build:android:apk"
          link_type: "package"
        - name: "Gecko v$CI_COMMIT_TAG APK (ARM64)"
          url: "$CI_PROJECT_URL/-/jobs/artifacts/$CI_COMMIT_TAG/raw/artifacts/android/gecko-${VERSION}-v8a.apk?job=build:android:apk"
          link_type: "package"
        - name: "Gecko v$CI_COMMIT_TAG APK (x86_64)"
          url: "$CI_PROJECT_URL/-/jobs/artifacts/$CI_COMMIT_TAG/raw/artifacts/android/gecko-${VERSION}-x86_64.apk?job=build:android:apk"
          link_type: "package"
        # Linux Desktop
        - name: "Gecko v$CI_COMMIT_TAG Linux Desktop (x64)"
          url: "$CI_PROJECT_URL/-/jobs/artifacts/$CI_COMMIT_TAG/raw/artifacts/linux/gecko-${VERSION}-linux-x64.tar.gz?job=build:linux"
          link_type: "package"

# Cleanup old artifacts (optional)
cleanup:artifacts:
  image: alpine:latest
  stage: .post
  rules:
    - if: $CI_COMMIT_TAG
      when: never
    - if: $CI_PIPELINE_SOURCE == "schedule"
  script:
    - echo "Cleanup job for scheduled pipelines"
    # Add cleanup logic here if needed