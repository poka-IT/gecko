# Gecko Environment Configuration Example
# Copy this file to .env and fill in your values

# Google Play Store Configuration
GOOGLE_PLAY_JSON_KEY_PATH=/path/to/your/google-play-key.json
ANDROID_PACKAGE_NAME=fr.axiomteam.gecko
GOOGLE_PLAY_TRACK=internal  # Options: internal, alpha, beta, production
GOOGLE_PLAY_RELEASE_STATUS=completed  # Options: completed, draft

# App Store Connect Configuration (API Key method - recommended)
APP_STORE_CONNECT_API_KEY_PATH=/path/to/your/app-store-key.p8
APP_STORE_CONNECT_API_KEY_ID=YOUR_KEY_ID
APP_STORE_CONNECT_API_ISSUER_ID=YOUR_ISSUER_ID
IOS_APP_IDENTIFIER=fr.axiomteam.gecko
APP_STORE_RELEASE_STATUS=manual  # Options: auto, manual, hold

# Legacy App Store Connect Configuration (deprecated)
# APPLE_ID=your.email@example.com
# APP_SPECIFIC_PASSWORD=your-app-specific-password
# BUNDLE_ID=fr.axiomteam.gecko

# CI/CD Configuration (optional, for local testing)
CI_PROJECT_URL=https://gitlab.com/axiom-team/gecko

# Forum Configuration (if testing forum posting locally)
# DUNITER_FORUM_URL=https://forum.duniter.org
# DUNITER_FORUM_API_KEY=your-forum-api-key
# DUNITER_FORUM_USERNAME=your-username
# DUNITER_FORUM_CATEGORY_ID=5