# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Force minimum deployment target to iOS 15.5 for all pods to avoid Xcode 16 warnings
    target.build_configurations.each do |config|
      current_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      # Force update ALL targets to 15.5, regardless of current value
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # Exclude arm64 from simulator builds — forces Rosetta (x86_64) on Apple Silicon.
      # Required because vendor frameworks (MLImage/Google ML Kit) don't include arm64-simulator slices.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      puts "Forced #{target.name} deployment target from #{current_target} to 15.5"
      
      # Also force update other iOS version settings that might conflict
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_1500')
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_1400')
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_1300')
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_1200')
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_1100')
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_1000')
      config.build_settings.delete('IPHONEOS_DEPLOYMENT_TARGET_900')
      
      # Force code signing to automatic for all pods (only if not already set)
      config.build_settings['CODE_SIGN_STYLE'] ||= 'Automatic'
      config.build_settings['DEVELOPMENT_TEAM'] ||= '2P2PNF45VD'
    end
  end
  
  # Also update the project-level deployment target
  installer.pods_project.build_configurations.each do |config|
    current_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
    # Force update project deployment target to 15.5
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    puts "Forced project deployment target from #{current_target} to 15.5"
    
    # Force code signing to automatic at project level (only if not already set)
    config.build_settings['CODE_SIGN_STYLE'] ||= 'Automatic'
    config.build_settings['DEVELOPMENT_TEAM'] ||= '2P2PNF45VD'
  end
  
  # Force update all aggregate targets
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config_file|
      config_file.attributes['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      config_file.attributes['CODE_SIGN_STYLE'] ||= 'Automatic'
      config_file.attributes['DEVELOPMENT_TEAM'] ||= '2P2PNF45VD'
      puts "Forced aggregate target #{aggregate_target.name} to 15.5 with automatic signing"
    end
  end
  
  # Final brute force: Update the Pods project file directly
  puts "Applying final brute force deployment target fixes..."
  installer.pods_project.save
  
  # Final step: Force update all .xcconfig files to override any hardcoded values
  Dir.glob("Pods/Target Support Files/**/*.xcconfig").each do |xcconfig_path|
    content = File.read(xcconfig_path)
    # Replace any IPHONEOS_DEPLOYMENT_TARGET with 15.5
    content.gsub!(/IPHONEOS_DEPLOYMENT_TARGET = [0-9]+\.[0-9]+/, 'IPHONEOS_DEPLOYMENT_TARGET = 15.5')
    File.write(xcconfig_path, content)
    puts "Updated #{xcconfig_path} deployment target to 15.5"
  end
  
  # Ultimate fix: Force update the Pods.xcodeproj file directly
  pods_project_path = "Pods/Pods.xcodeproj/project.pbxproj"
  if File.exist?(pods_project_path)
    content = File.read(pods_project_path)
    # Replace all IPHONEOS_DEPLOYMENT_TARGET values with 15.5
    content.gsub!(/IPHONEOS_DEPLOYMENT_TARGET = [0-9]+\.[0-9]+;/, 'IPHONEOS_DEPLOYMENT_TARGET = 15.5;')
    content.gsub!(/IPHONEOS_DEPLOYMENT_TARGET = "[0-9]+\.[0-9]+";/, 'IPHONEOS_DEPLOYMENT_TARGET = "15.5";')
    File.write(pods_project_path, content)
    puts "Updated Pods.xcodeproj deployment targets to 15.5"
  end
end
