# Gecko CI Optimized Docker Image
# Pre-installs all dependencies to speed up CI builds
# Based on analysis of .gitlab-ci.yml jobs

FROM ghcr.io/cirruslabs/flutter:3.32.8

# Set environment variables
ENV FLUTTER_VERSION=3.32.8
ENV DEBIAN_FRONTEND=noninteractive

# Update package lists
RUN apt-get update -y

# Install Java 17 for Android builds
RUN apt-get install -y openjdk-17-jdk

# Set JAVA_HOME dynamically (will be set correctly for both amd64 and arm64)
RUN export JAVA_HOME=$(find /usr/lib/jvm -name "java-17-openjdk*" | head -1) && \
    echo "export JAVA_HOME=$JAVA_HOME" >> /etc/environment && \
    echo "export PATH=\$JAVA_HOME/bin:\$PATH" >> /etc/environment
ENV PATH=/usr/lib/jvm/java-17-openjdk/bin:$PATH

# Install Android build dependencies and NDK
RUN apt-get install -y \
    android-sdk \
    android-sdk-platform-tools \
    android-sdk-build-tools

# Set Android SDK environment variables
ENV ANDROID_SDK_ROOT=/opt/android-sdk-linux
ENV ANDROID_HOME=/opt/android-sdk-linux
ENV PATH=$PATH:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools

# Create SDK directories and install NDK
RUN mkdir -p $ANDROID_SDK_ROOT/cmdline-tools && \
    cd $ANDROID_SDK_ROOT/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip -q commandlinetools-linux-11076708_latest.zip && \
    mv cmdline-tools latest && \
    rm commandlinetools-linux-11076708_latest.zip

# Accept Android licenses and install multiple NDK versions and CMake
# First, find the correct JAVA_HOME for this architecture
RUN export JAVA_HOME=$(find /usr/lib/jvm -name "java-17-openjdk*" | head -1) && \
    echo "Using JAVA_HOME: $JAVA_HOME" && \
    yes | $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --licenses && \
    $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager \
        "ndk;27.2.12479018" \
        "ndk;26.3.11579264" \
        "cmake;3.22.1" \
        "platforms;android-34" \
        "build-tools;34.0.0"

# Install Linux desktop build dependencies
RUN apt-get install -y \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libsecret-1-dev \
    libcurl4-openssl-dev

# Install Ruby and build tools for fastlane (Android deployment)
RUN apt-get install -y \
    ruby \
    ruby-dev \
    build-essential \
    git

# Install Python for forum publishing
RUN apt-get install -y \
    python3 \
    python3-pip

# Install fastlane for app store deployments
RUN gem install fastlane -NV

# Install Python dependencies for forum publishing
# Use --break-system-packages to override the externally-managed-environment restriction
RUN pip3 install --break-system-packages pydiscourse

# Install additional utilities
RUN apt-get install -y \
    curl \
    wget \
    unzip \
    tar \
    gzip

# Configure Flutter
RUN flutter --version
RUN flutter config --enable-linux-desktop
RUN flutter doctor --android-licenses || true

# Pre-download Flutter dependencies (common packages)
RUN flutter create temp_project && \
    cd temp_project && \
    flutter pub get && \
    cd .. && \
    rm -rf temp_project

# Clean up apt cache to reduce image size
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set working directory
WORKDIR /workspace

# Copy scripts for CI setup (these will be available in the container)
COPY scripts/setup-ci-dependencies.sh /usr/local/bin/setup-ci-dependencies.sh
COPY scripts/setup-android-signing.sh /usr/local/bin/setup-android-signing.sh

# Make scripts executable
RUN chmod +x /usr/local/bin/setup-ci-dependencies.sh
RUN chmod +x /usr/local/bin/setup-android-signing.sh

# Verify installations
RUN echo "=== Verification ===" && \
    flutter --version && \
    java -version && \
    fastlane --version && \
    python3 --version && \
    pip3 --version && \
    cmake --version && \
    echo "Android SDK: $ANDROID_SDK_ROOT" && \
    ls -la $ANDROID_SDK_ROOT/ndk/ && \
    echo "=== All dependencies installed successfully ==="

# Default command
CMD ["/bin/bash"]
